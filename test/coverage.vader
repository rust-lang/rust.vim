Given rust (Some Rust code):
  fn main() {
      println!("Hello World\n")
  }

Execute (RustInfo - call it to see that it works):
  redir => m
  silent RustInfo
  redir END
  Log m

Execute (RustEmitAsm - see that we actually get assembly output):
  silent! w test.rs
  silent! e! test.rs
  redir => m
  silent! RustEmitAsm
  redir END
  AssertEqual 'asm', &filetype
  normal! ggVGy:q<CR>
  AssertEqual 1,(@" =~# '\V.section')
  bd
  call delete('test.rs')

Given rust (await syntax highlighting):
  async fn main() {
      foo.await?;
      foo.await.bar();
      foo.awaiting();
  }

Execute (.await only highlights postfix await):
  AssertEqual 'rustAwait', synIDattr(synID(2, 9, 1), 'name')
  AssertEqual 'rustAwait', synIDattr(synID(3, 9, 1), 'name')
  AssertEqual 'rustFuncCall', synIDattr(synID(4, 9, 1), 'name')

